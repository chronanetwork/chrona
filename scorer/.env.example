# Helius API key (used for getSignaturesForAddress + Enhanced Transactions API)
HELIUS_API_KEY=

# Which cluster's activity to score. Wallets are scored on mainnet activity.
SCORER_CLUSTER=mainnet

# Oracle ed25519 signing key — base58 string or JSON array (64 bytes).
# Must correspond to the on-chain GlobalState.oracle_pubkey. Use a KMS in prod.
ORACLE_SECRET_KEY=

# How long a signed attestation stays valid (seconds).
ATTESTATION_VALIDITY_SECS=900

# HTTP port
PORT=8787

# Scan cap + time budget (bounded cost). Each tx page = up to 1000 full txs.
MAX_TX_PAGES=10
MEASURE_BUDGET_MS=30000

# Optional: pin SOL/USD for reproducible volume valuation.
# SOL_PRICE_USD=150

# ---- poke keeper (prunes decayed miners) ----
# Runs alongside the scorer. Operates on the PROGRAM's cluster (devnet today).
KEEPER_ENABLED=false
KEEPER_RPC_URL=https://devnet.helius-rpc.com/?api-key=YOUR_KEY
# Keypair that pays poke tx fees (base58 or JSON array). Needs a little SOL.
KEEPER_SECRET_KEY=
KEEPER_INTERVAL_MS=1800000
KEEPER_MAX_PER_CYCLE=25

# Jupiter Price API key (served via GET /price so it stays off the client)
JUP_API_KEY=

# Optional: wallet to track on the public buyback/burn dashboard (GET /buyback).
# Defaults to the deployer/treasury.
# DEV_WALLET=B1xtqSHWRaGMpPkfgkFYPsLkvQKzF7pLUckTF53kairo

# ---- buyback-and-burn flywheel ----
# Every cycle: if the wallet's SOL balance exceeds the trigger, keep RESERVE_SOL,
# send half the excess to the payout wallet, and buy back $KAIRO with the other
# half via Jupiter — then burn it. SECURITY: FLYWHEEL_SECRET_KEY is a HOT key on
# this server. Prefer making the program immutable + moving admin authority off
# this key first, so a server compromise can only touch treasury SOL.
FLYWHEEL_ENABLED=false
# Always start with a dry run (computes + logs, never signs/sends) to verify.
FLYWHEEL_DRY_RUN=true
# Treasury/deployer key that holds the fees (base58 or JSON array).
FLYWHEEL_SECRET_KEY=
# Mainnet RPC (defaults to Helius mainnet using HELIUS_API_KEY).
# FLYWHEEL_RPC_URL=
FLYWHEEL_PAYOUT_WALLET=5c3BPQmhXo42CUEZHTSXiSJ5DmwhvGA8eGfvPgi9sAxh
FLYWHEEL_RESERVE_SOL=10
FLYWHEEL_TRIGGER_SOL=11
FLYWHEEL_INTERVAL_MS=300000
# Swap slippage tolerance (bps) and a per-cycle buyback ceiling (0 = no cap).
FLYWHEEL_SLIPPAGE_BPS=300
FLYWHEEL_MAX_BUYBACK_SOL=0
# Skimmed from the buyback leg to cover network/priority fees (protects reserve).
FLYWHEEL_FEE_BUFFER_SOL=0.03
